{
  "name": "orangehrm/employee-management-enhancement",
  "description": "OrangeHRM Employee Management System enhancement built on a Symfony-based PHP architecture.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^3.8",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/migrations": "^3.7",
    "doctrine/orm": "^2.17 || ^3.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/console": "^7.1",
    "symfony/dotenv": "^7.1",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "^7.1",
    "symfony/runtime": "^7.1",
    "symfony/security-bundle": "^7.1",
    "symfony/validator": "^7.1",
    "symfony/yaml": "^7.1"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.1.*"
    }
  }
}