{
    "name": "orangehrm/leave-balance-alert",
    "description": "OrangeHRM Demo - Leave Balance Alert capability (PIM extension)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^3.7",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^2.17",
        "monolog/monolog": "^3.5",
        "symfony/asset": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/serializer": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/browser-kit": "^6.4",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "db-migrate": "php bin/console doctrine:migrations:migrate --no-interaction",
        "cache-clear": "php bin/console cache:clear",
        "assets-build": "php bin/console assets:install public",
        "lint": "php -l src/Kernel.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}