{
  "name": "orangehrm/employee-audit-history",
  "description": "OrangeHRM Employee Audit History backend implementation aligned with existing Symfony-style OrangeHRM conventions.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "doctrine/dbal": "^3.8",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^2.18",
    "symfony/dependency-injection": "^6.4",
    "symfony/dotenv": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/http-foundation": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/runtime": "^6.4",
    "symfony/security-bundle": "^6.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "OrangeHRM\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OrangeHRM\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "sort-packages": true
  },
  "scripts": {
    "validate": "composer validate --strict"
  }
}