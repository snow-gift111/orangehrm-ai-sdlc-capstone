{
  "name": "orangehrm/ai-sdlc-capstone",
  "description": "OrangeHRM Employee Audit History enhancement application bootstrap.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.2",
    "symfony/console": "^7.1",
    "symfony/dotenv": "^7.1",
    "symfony/framework-bundle": "^7.1",
    "symfony/runtime": "^7.1",
    "symfony/serializer": "^7.1",
    "symfony/validator": "^7.1",
    "symfony/yaml": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2",
    "symfony/phpunit-bridge": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "App\\\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\\\Tests\\\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "scripts": {
    "auto-scripts": {},
    "clear-cache": "symfony-cmd",
    "post-install-cmd": [
      "@clear-cache"
    ],
    "post-update-cmd": [
      "@clear-cache"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}